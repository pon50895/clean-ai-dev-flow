#!/usr/bin/env sh
# .githooks/pre-push - portable kit gate. Generic segments only; everything is
# read from kit.json (.claude/kit.json or kit.json) via scripts/kit/kit.mjs.
# A disabled / unconfigured module is skipped silently.
#
# Git passes pushed refs on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# Segments                              kit.json                          Escape hatch
#   1 protected-branch push block       protectedBranches                 ALLOW_MAIN_PUSH=1
#   2 force-push (history rewrite)      -                                 ALLOW_FORCE_PUSH=1
#   3 lint ratchet                      modules.lintRatchet +             ALLOW_DIRTY_LINT=1
#                                       ratchet.lint.workspaces
#   4 tsc ratchet                       modules.tscRatchet +              ALLOW_DIRTY_TSC=1
#                                       ratchet.tsc.workspaces
#   5 ponytail semi-blocking ack        modules.ponytailAck               PONYTAIL_REVIEWED=1

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
KIT="$ROOT/scripts/kit"

kit_get() {
  [ -f "$KIT/kit.mjs" ] && command -v node >/dev/null 2>&1 || return 0
  node "$KIT/kit.mjs" get "$1" 2>/dev/null || true
}
kit_on() {
  v="$(kit_get "modules.$1")"
  [ -n "$v" ] || v="$2"
  [ "$v" = "true" ]
}

PROTECTED_BRANCHES="$(kit_get protectedBranches)"
[ -n "$PROTECTED_BRANCHES" ] || PROTECTED_BRANCHES="main
master"
ZERO="0000000000000000000000000000000000000000"

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # --- 1. Block push to protected remote branches -----------------------------
  for protected in $PROTECTED_BRANCHES; do
    if [ "$REMOTE_REF" = "refs/heads/$protected" ]; then
      if [ "$ALLOW_MAIN_PUSH" = "1" ]; then
        echo "[pre-push] WARNING: Pushing to '$REMOTE_REF' (ALLOW_MAIN_PUSH=1 set)."
        continue
      fi
      echo ""
      echo "============================================================"
      echo "[pre-push] BLOCKED: Direct push to '$REMOTE_REF' is not allowed."
      echo "============================================================"
      echo ""
      echo "All changes go through a PR:"
      echo "  git push -u origin <your-feature-branch>"
      echo "  gh pr create --base $protected --fill"
      echo ""
      echo "Maintainer override:  ALLOW_MAIN_PUSH=1 git push origin $protected"
      echo ""
      exit 1
    fi
  done

  # --- 2. Detect force push (rewriting history on the remote) -----------------
  # Skip new-branch (REMOTE_SHA zero) and delete (LOCAL_SHA zero).
  if [ "$REMOTE_SHA" != "$ZERO" ] && [ "$LOCAL_SHA" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
      if [ "$ALLOW_FORCE_PUSH" = "1" ]; then
        echo "[pre-push] WARNING: Force push detected to '$REMOTE_REF' (ALLOW_FORCE_PUSH=1 set)."
      else
        echo ""
        echo "============================================================"
        echo "[pre-push] BLOCKED: Force push (history rewrite) detected."
        echo "============================================================"
        echo "  Branch: $REMOTE_REF"
        echo ""
        echo "Force push destroys remote commits. If intentional (e.g. after a"
        echo "rebase on your own feature branch):"
        echo "  ALLOW_FORCE_PUSH=1 git push --force-with-lease ..."
        echo ""
        exit 1
      fi
    fi
  fi
done

# Base ref for the diff-scoped gates below.
BASE_REF="$(kit_get baseRef)"
[ -n "$BASE_REF" ] || BASE_REF="origin/main"
if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null; then
  if git rev-parse --verify --quiet HEAD~1 >/dev/null; then
    BASE_REF="HEAD~1"
  else
    BASE_REF=""
  fi
fi

# --- 3. Lint ratchet ----------------------------------------------------------
# Fails ONLY on regression vs the baseline (errors+warnings per workspace).
# lint-runner --since scopes to the workspaces the diff touched; a diff touching
# lint config / baseline / lockfile runs everything. Skipped when no workspace is
# configured. Lower the ceiling after cleanups:
#   node scripts/kit/lint-runner.mjs --mode=baseline
if kit_on lintRatchet false && [ -f "$KIT/lint-runner.mjs" ] && command -v node >/dev/null 2>&1 \
   && [ -n "$BASE_REF" ] && [ "$(kit_get ratchet.lint.workspaces.length)" -gt 0 ] 2>/dev/null; then
  if [ "$ALLOW_DIRTY_LINT" = "1" ]; then
    echo "[pre-push] WARNING: Skipping lint gate (ALLOW_DIRTY_LINT=1 set)."
  else
    if ! node "$KIT/lint-runner.mjs" --mode=check "--since=$BASE_REF"; then
      echo ""
      echo "============================================================"
      echo "[pre-push] BLOCKED: lint problems regressed vs baseline."
      echo "============================================================"
      echo "Fix the new errors/warnings above. If you lowered the count on purpose:"
      echo "  node scripts/kit/lint-runner.mjs --mode=baseline"
      echo ""
      echo "Escape hatch (NOT RECOMMENDED):  ALLOW_DIRTY_LINT=1 git push ..."
      echo ""
      exit 1
    fi
  fi
fi

# --- 4. tsc --noEmit ratchet ---------------------------------------------------
# Fails ONLY on regression vs the baseline; skipped when no workspace is configured.
#   node scripts/kit/tsc-runner.mjs --mode=baseline   (lower the ceiling)
if kit_on tscRatchet false && [ -f "$KIT/tsc-runner.mjs" ] && command -v node >/dev/null 2>&1 \
   && [ -n "$BASE_REF" ] && [ "$(kit_get ratchet.tsc.workspaces.length)" -gt 0 ] 2>/dev/null; then
  if [ "$ALLOW_DIRTY_TSC" = "1" ]; then
    echo "[pre-push] WARNING: Skipping tsc gate (ALLOW_DIRTY_TSC=1 set)."
  else
    if ! node "$KIT/tsc-runner.mjs" --mode=check "--since=$BASE_REF"; then
      echo ""
      echo "============================================================"
      echo "[pre-push] BLOCKED: tsc errors regressed vs baseline."
      echo "============================================================"
      echo "Fix the new type errors above. If you lowered the count on purpose:"
      echo "  node scripts/kit/tsc-runner.mjs --mode=baseline"
      echo ""
      echo "Escape hatch (NOT RECOMMENDED):  ALLOW_DIRTY_TSC=1 git push ..."
      echo ""
      exit 1
    fi
  fi
fi

# --- 5. ponytail over-engineering gate (semi-blocking) ------------------------
# /ponytail-review is agent-driven (an LLM judges over-engineering), so a shell
# hook cannot run it. It BLOCKS code pushes until you assert you ran it with
# PONYTAIL_REVIEWED=1 - a deliberate ack that breaks the build->test->push
# auto-pilot for the one judgment gate machines cannot enforce.
if kit_on ponytailAck false && [ -n "$BASE_REF" ]; then
  # What counts as code: kit.json ponytail.codeExtensions (one per line from kit_get); default JS / TS.
  CODE_EXT="$(kit_get ponytail.codeExtensions | paste -sd'|' -)"
  [ -n "$CODE_EXT" ] || CODE_EXT="ts|tsx|js|jsx"
  if git diff --name-only --diff-filter=ACMR "$BASE_REF"...HEAD 2>/dev/null \
     | grep -qE "\.($CODE_EXT)\$"; then
    if [ "$PONYTAIL_REVIEWED" != "1" ]; then
      echo "[pre-push] BLOCKED: code diff detected but /ponytail-review not confirmed."
      echo "[pre-push]   1) run /ponytail-review on this diff; apply the delete-list"
      echo "[pre-push]      (or mark deliberate keeps with a 'ponytail:' comment)."
      echo "[pre-push]   2) re-push with:  PONYTAIL_REVIEWED=1 git push"
      exit 1
    fi
    echo "[pre-push] ponytail-review acknowledged (PONYTAIL_REVIEWED=1)."
  fi
fi

exit 0
