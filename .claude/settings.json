{
  "_comment": "Project-shared Claude Code settings (committed). Universal allow + ask + ALL deny. Per-developer paths / bypasses / personal tools live in settings.local.json (gitignored). Mirrors dev-rule/sample/settings.json — same content shipped via git rather than via apply-claude-settings.sh.",

  "_doc_tiers": "Three-tier permission model: allow (auto-approve, no prompt) / ask (always prompt user) / deny (hard block, no prompt). More-specific patterns override less-specific (so Bash(npx playwright:*) in allow wins over Bash(npx:*) in ask). See dev-rule/SECURITY_STANDARDS.md.",

  "_doc_hooks": "Hooks complement permissions, they don't replace them. The permission matcher does substring/glob matching and sees a chained command (a && rm -rf b) as ONE string, so it misses destructive verbs in the middle. Hooks regex the FULL command. Run `bash scripts/colyn-roles/hook-selftest.sh` after touching any guard — it runs positive+negative controls, because a guard that silently stops firing looks exactly like a guard with nothing to catch.",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/colyn-roles/session-learning-inject.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/redline-guard.js\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-destructive-guard.js\"" }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-brief-guard.js\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/opus5-verify-reminder.js\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/over-ask-reminder.js\"" }
        ]
      }
    ]
  },

